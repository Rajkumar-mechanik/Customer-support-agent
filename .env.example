# ---- Required for the live agents -------------------------------------------------------------
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Optional (defaults shown) ----------------------------------------------------------------
# LLM_TEMPERATURE=0
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_ATTEMPTS=2
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_COVERAGE=0.42     # raise to be stricter about "no matching document"
# RETRIEVER=lexical               # lexical | hybrid (adds embedding re-ranking, needs the API key)
# EMBEDDING_MODEL=text-embedding-3-small
# CONFIDENCE_THRESHOLD=0.6        # below this a ticket is escalated
# MAX_COMPLAINT_CHARS=2000
# RATE_LIMIT_PER_MINUTE=6         # per browser session; 0 disables
# COMPANY_NAME=Brightwell
# LOG_LEVEL=INFO
# KB_DIR=knowledge_base
# LOG_DIR=logs

# ---- Without a key ----------------------------------------------------------------------------
# By default, with no key the desk runs in SAFE MODE: every ticket is logged and escalated to a
# person. Set DEMO_MODE=true to run a clearly-labelled simulated agent team instead (for UI demos).
# DEMO_MODE=false
